<!doctype html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1080">
<title>Дело в огне — Меню (Экран 1)</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }

@media screen and (orientation: landscape) {
  html { overflow: hidden; }
  body {
    width: 100vh;
    min-height: 100vw;
    transform-origin: top left;
    transform: rotate(-90deg) translateX(-100vw);
    overflow: hidden;
  }
  .page { width: 100% !important; min-height: 100vw !important; }
}
@media screen and (orientation: portrait) {
  html, body { width: 1080px; min-height: 1920px; }
}

:root {
  --bg: #090705;
  --page: #0c0c0e;
  --shell: #151517;
  --panel: #1b1c20;
  --panel-2: #202126;
  --fire: #d42b1a;
  --accent-soft: #ff6b6b;
  --fire-soft: rgba(212,43,26,0.14);
  --text: #f7f1ea;
  --muted: rgba(247,241,234,0.62);
  --line: rgba(255,255,255,0.08);
  --line-strong: rgba(212,43,26,0.22);
}

html, body {
  background: var(--bg);
  color: var(--text);
  font-family: Inter, "Segoe UI", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

@keyframes ember-breathe {
  0%,100% { opacity: .92; transform: scale(1); }
  50% { opacity: .58; transform: scale(1.03); }
}
@keyframes spark-rise {
  0% { transform: translateY(0) translateX(0) scale(1); opacity: 0; }
  15% { opacity: .7; }
  100% { transform: translateY(-420px) translateX(var(--sway)) scale(.25); opacity: 0; }
}
@keyframes glow-pulse {
  0%,100% { box-shadow: 0 0 0 rgba(212,43,26,0); }
  50% { box-shadow: 0 0 30px rgba(212,43,26,.24); }
}
@keyframes flicker {
  0% { transform: rotate(-2deg) scale(1); opacity: 1; }
  25% { transform: rotate(1deg) scale(1.06); opacity: .88; }
  50% { transform: rotate(-1deg) scale(.97); opacity: 1; }
  75% { transform: rotate(2deg) scale(1.04); opacity: .9; }
  100% { transform: rotate(-2deg) scale(1); opacity: 1; }
}

.page {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  width: 1080px;
  min-height: 1920px;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(ellipse 96% 41% at 50% 102%, rgba(212,43,26,.38), transparent 58%),
    radial-gradient(ellipse 78% 24% at 50% 96%, rgba(255,107,107,.12), transparent 62%),
    radial-gradient(ellipse 70% 24% at 20% 88%, rgba(200,25,20,.08), transparent 66%),
    radial-gradient(ellipse 70% 24% at 80% 86%, rgba(200,25,20,.08), transparent 66%),
    linear-gradient(180deg, #111114 0%, #090705 28%, #090705 100%);
}
.page::before,
.page::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 0;
}
.page::before {
  background:
    radial-gradient(ellipse 94% 36% at 50% 103%, rgba(212,43,26,.26), transparent 56%),
    radial-gradient(ellipse 76% 22% at 50% 98%, rgba(255,107,107,.14), transparent 60%);
  animation: ember-breathe 5.5s ease-in-out infinite;
}
.page::after {
  background:
    radial-gradient(ellipse 36% 13% at 18% 97%, rgba(212,43,26,.12), transparent 70%),
    radial-gradient(ellipse 36% 13% at 82% 97%, rgba(212,43,26,.12), transparent 70%);
  animation: ember-breathe 7s ease-in-out infinite reverse;
}
.page > * { position: relative; z-index: 1; }
.sparks {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 0;
}
.spark {
  position: absolute;
  bottom: 40px;
  width: 7.5px;
  height: 7.5px;
  border-radius: 50%;
  background: radial-gradient(circle, #ff8a8a, #d42b1a 72%);
  box-shadow: 0 0 12px rgba(212,43,26,.85);
  animation: spark-rise var(--dur, 3.8s) ease-out infinite;
  animation-delay: var(--delay, 0s);
}

.body {
  flex: 1;
  padding: 8px 18px 8px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.section {
  background: linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,.012));
  border: 1px solid var(--line);
  border-radius: 14px;
  overflow: hidden;
}
.section-head {
  padding: 8px 14px 7px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  border-bottom: 1px solid var(--line);
  background: linear-gradient(90deg, rgba(212,43,26,.18), rgba(212,43,26,.04) 68%, transparent);
}
.section-title {
  font-size: 24px;
  font-weight: 900;
  letter-spacing: -.03em;
  display: flex;
  align-items: center;
  gap: 8px;
}
.section-sub {
  font-size: 13px;
  color: var(--muted);
  text-align: right;
}
.section-note {
  padding: 6px 14px;
  font-size: 12px;
  color: rgba(247,241,234,.40);
  border-bottom: 1px solid var(--line);
}

.fire-deco {
  display: inline-block;
  animation: flicker 2.3s ease-in-out infinite;
  filter: drop-shadow(0 0 10px rgba(212,43,26,.7));
}

.grill-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
}
.grill-item {
  padding: 11px 13px 10px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.grill-item:nth-child(even) { border-right: none; }
.grill-item:nth-last-child(-n+2) { border-bottom: none; }

.hit-badge {
  display: inline-flex;
  width: fit-content;
  align-items: center;
  gap: 6px;
  padding: 2px 7px;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
  border-radius: 7px;
  background: var(--fire);
  color: #fff;
  animation: glow-pulse 3s ease-in-out infinite;
}
.grill-name {
  font-size: 19px;
  font-weight: 800;
  line-height: 1.02;
}
.grill-desc {
  font-size: 12px;
  line-height: 1.12;
  color: var(--muted);
}
.grill-bottom {
  margin-top: 4px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.grill-measure {
  font-size: 13px;
  color: rgba(247,241,234,.52);
}
.grill-anchor {
  display: inline-flex;
  align-items: baseline;
  gap: 6px;
  width: fit-content;
  padding: 5px 8px;
  border-radius: 9px;
  background: rgba(212,43,26,.14);
  border: 1px solid rgba(212,43,26,.30);
}
.grill-anchor-qty {
  font-size: 12px;
  color: rgba(247,241,234,.68);
}
.grill-anchor-price {
  font-size: 30px;
  font-weight: 900;
  color: var(--accent-soft);
  line-height: 1;
}
.grill-price-fixed {
  font-size: 30px;
  font-weight: 900;
  line-height: 1;
  color: var(--accent-soft);
}
.grill-weight {
  font-size: 13px;
  color: var(--muted);
}

.row-list { display: flex; flex-direction: column; }
.row-item {
  display: flex;
  gap: 10px;
  padding: 8px 14px;
  border-bottom: 1px solid var(--line);
}
.row-item:last-child { border-bottom: none; }
.row-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.row-name {
  font-size: 19px;
  font-weight: 800;
  line-height: 1.02;
}
.row-desc {
  font-size: 12px;
  color: var(--muted);
  line-height: 1.12;
}
.row-right {
  min-width: 126px;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2px;
}
.row-price {
  font-size: 30px;
  font-weight: 900;
  color: var(--accent-soft);
  line-height: 1;
  white-space: nowrap;
}
.row-weight {
  font-size: 12px;
  color: var(--muted);
}

</style>
</head>
<body>
<div class="page">
  <div class="sparks" aria-hidden="true">
    <div class="spark" style="left:8%;--dur:3.6s;--delay:.2s;--sway:18px;"></div>
    <div class="spark" style="left:12%;--dur:4.1s;--delay:2.1s;--sway:-10px;"></div>
    <div class="spark" style="left:17%;--dur:4.4s;--delay:1.3s;--sway:-16px;"></div>
    <div class="spark" style="left:28%;--dur:3.2s;--delay:.9s;--sway:14px;"></div>
    <div class="spark" style="left:33%;--dur:4.9s;--delay:2.4s;--sway:-18px;"></div>
    <div class="spark" style="left:39%;--dur:4.7s;--delay:0s;--sway:-12px;"></div>
    <div class="spark" style="left:51%;--dur:3.4s;--delay:1.6s;--sway:22px;"></div>
    <div class="spark" style="left:57%;--dur:3.9s;--delay:2.7s;--sway:-15px;"></div>
    <div class="spark" style="left:63%;--dur:4.8s;--delay:.5s;--sway:-20px;"></div>
    <div class="spark" style="left:76%;--dur:3.5s;--delay:1.1s;--sway:16px;"></div>
    <div class="spark" style="left:82%;--dur:4.3s;--delay:2.2s;--sway:12px;"></div>
    <div class="spark" style="left:88%;--dur:4.2s;--delay:1.9s;--sway:-14px;"></div>
    <div class="spark" style="left:93%;--dur:3.7s;--delay:.8s;--sway:10px;"></div>
  </div>

  <div class="body">
    <div class="section">
      <div class="section-head">
        <div class="section-title">Мясо на углях <span class="fire-deco">🔥</span></div>
        <div class="section-sub">называйте вес · от 100 г</div>
      </div>
      <div class="section-note">Цена за 100 г · взвешиваем при вас · чем больше берёте — выгоднее</div>
      <div class="grill-grid">
        <div class="grill-item">
          <div class="hit-badge">🔥 Хит</div>
          <div class="grill-name">Шашлык из свинины</div>
          <div class="grill-desc">Свиная шейка в авторском маринаде — сочная, с аппетитной корочкой</div>
          <div class="grill-bottom">
            <div class="grill-measure">200 р. / 100 г</div>
            <div class="grill-anchor">
              <span class="grill-anchor-qty">чаще берут 300 г →</span>
              <span class="grill-anchor-price">600 р.</span>
            </div>
          </div>
        </div>

        <div class="grill-item">
          <div class="hit-badge">🔥 Хит</div>
          <div class="grill-name">Люля-кебаб</div>
          <div class="grill-desc">Рубленая свинина и говядина со специями на шампуре</div>
          <div class="grill-bottom">
            <div class="grill-measure">256 р. / 100 г</div>
            <div class="grill-anchor">
              <span class="grill-anchor-qty">чаще берут 300 г →</span>
              <span class="grill-anchor-price">768 р.</span>
            </div>
          </div>
        </div>

        <div class="grill-item">
          <div class="grill-name">Куриное бедро</div>
          <div class="grill-desc">Нежное мясо с хрустящей кожицей, приготовленное на мангале</div>
          <div class="grill-bottom">
            <div class="grill-price-fixed">590 р.</div>
            <div class="grill-weight">1 шт.</div>
          </div>
        </div>

        <div class="grill-item">
          <div class="grill-name">Куриная грудка</div>
          <div class="grill-desc">Филе на живом огне — сочно и легко</div>
          <div class="grill-bottom">
            <div class="grill-price-fixed">590 р.</div>
            <div class="grill-weight">1 шт.</div>
          </div>
        </div>

        <div class="grill-item">
          <div class="grill-name">Крылья на мангале</div>
          <div class="grill-desc">Хрустящие снаружи, сочные внутри</div>
          <div class="grill-bottom">
            <div class="grill-price-fixed">480 р.</div>
            <div class="grill-weight">300 г</div>
          </div>
        </div>

        <div class="grill-item">
          <div class="grill-name">Стейк бедра куриный</div>
          <div class="grill-desc">Сочный куриный стейк на живом огне</div>
          <div class="grill-bottom">
            <div class="grill-price-fixed">590 р.</div>
            <div class="grill-weight">1 шт.</div>
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section-head">
        <div class="section-title">Овощи и гриль</div>
      </div>
      <div class="row-list">
        <div class="row-item">
          <div class="row-left">
            <div class="row-name">Овощи на огне</div>
            <div class="row-desc">Болгарский перец, кабачки, помидоры, грибы</div>
          </div>
          <div class="row-right">
            <div class="row-price">900 р.</div>
            <div class="row-weight">порция</div>
          </div>
        </div>
        <div class="row-item">
          <div class="row-left">
            <div class="row-name">Грибы на огне</div>
            <div class="row-desc">Шампиньоны на мангале — с дымком и зеленью</div>
          </div>
          <div class="row-right">
            <div class="row-price">540 р.</div>
            <div class="row-weight">порция</div>
          </div>
        </div>
        <div class="row-item">
          <div class="row-left">
            <div class="row-name">Картофель в беконе</div>
            <div class="row-desc">Запечённый на углях картофель в хрустящем беконе</div>
          </div>
          <div class="row-right">
            <div class="row-price">550 р.</div>
            <div class="row-weight">порция</div>
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section-head">
        <div class="section-title">Шашлык в лаваше</div>
        <div class="section-sub">мясо + лук + соус</div>
      </div>
      <div class="row-list">
        <div class="row-item">
          <div class="row-left">
            <div class="row-name">Свинина в лаваше</div>
            <div class="row-desc">Шашлык из свинины, маринованный лук, соус</div>
          </div>
          <div class="row-right">
            <div class="row-price">450 р.</div>
            <div class="row-weight">300 г</div>
          </div>
        </div>
        <div class="row-item">
          <div class="row-left">
            <div class="row-name">Курица в лаваше</div>
            <div class="row-desc">Шашлык из курицы, маринованный лук, соус</div>
          </div>
          <div class="row-right">
            <div class="row-price">450 р.</div>
            <div class="row-weight">300 г</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
</body>
</html>
